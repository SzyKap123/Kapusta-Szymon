# Wzór ustawień. NIGDY nie wpisuj prawdziwych kluczy do tego pliku ani do kodu.
# Prawdziwe wartości wpisujesz w: Netlify (Site configuration -> Environment variables)
# oraz GitHub (Settings -> Secrets and variables -> Actions). Instrukcja: docs/INSTRUKCJA-URUCHOMIENIA.md

# --- Strona ---
NEXT_PUBLIC_SITE_URL=https://twojadomena.pl
NEXT_PUBLIC_SITE_NAME=Typy AI
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@twojadomena.pl
NEXT_PUBLIC_OPERATOR_NAME=Jan Kowalski
NEXT_PUBLIC_OPERATOR_ADDRESS=ul. Przykładowa 1, 00-001 Warszawa
ADMIN_EMAIL=twoj-email@gmail.com

# --- Ceny (zł) ---
COUPON_PRICE_PLN=9
SUBSCRIPTION_PRICE_PLN=39
QUARTERLY_LIMIT_PLN=10813.50

# --- Supabase (baza danych i logowanie) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Stripe (płatności) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (e-maile) ---
RESEND_API_KEY=re_...
EMAIL_FROM=Typy AI <typy@twojadomena.pl>

# --- Tylko dla GitHub Actions (generowanie typów) ---
API_FOOTBALL_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
